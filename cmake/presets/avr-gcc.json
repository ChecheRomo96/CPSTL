{
  "version": 6,
  "include": [
    "base.json",
    "../../tools/RoModularBuild/cmake/presets/avr-gcc.json"
  ],
  "configurePresets": [
    {
      "name": "atmega328p_avrgcc_avr5",
      "inherits": [
        "base",
        "romodular_atmega328p_avrgcc_avr5"
      ],
      "toolchainFile": "${sourceDir}/tools/RoModularBuild/cmake/toolchains/avr-gcc/atmega328p.cmake",
      "cacheVariables": {
        "CPSTL_ALLOCATION": "C",
        "CPSTL_AVR_SMOKE": "ON"
      }
    },
    {
      "name": "atmega2560_avrgcc_avr6",
      "inherits": [
        "base",
        "romodular_atmega2560_avrgcc_avr6"
      ],
      "toolchainFile": "${sourceDir}/tools/RoModularBuild/cmake/toolchains/avr-gcc/atmega2560.cmake",
      "cacheVariables": {
        "CPSTL_ALLOCATION": "C",
        "CPSTL_AVR_SMOKE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "atmega328p_avrgcc_avr5",
      "configurePreset": "atmega328p_avrgcc_avr5",
      "configuration": "Debug"
    },
    {
      "name": "atmega2560_avrgcc_avr6",
      "configurePreset": "atmega2560_avrgcc_avr6",
      "configuration": "Debug"
    }
  ]
}
