PROJECT_NAME           = "CPSTL"
PROJECT_NUMBER         = "1.1.5"
PROJECT_BRIEF          = "Cross-Platform STL for hosted and freestanding C++"
OUTPUT_DIRECTORY       = build/documentation
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
INPUT                  = README.md CHANGELOG.md docs src
FILE_PATTERNS          = *.dox *.md *.h *.tpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */tools/*
EXTRACT_ALL            = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FOOTER            = docs/assets/CPSTLFooter.html
HTML_EXTRA_FILES       = docs/assets/CPSTLDocs.js
HTML_COLORSTYLE        = TOGGLE
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = NO
HTML_CODE_FOLDING      = YES
HTML_COPY_CLIPBOARD    = YES
GENERATE_TREEVIEW      = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
